{
  "name": "wallfly",
  "version": "0.1.3",
  "private": true,
  "description": "A self-hosted WhatsApp client with local storage and an explicit, audited send surface.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "daemon": "npm run build && node bin/wallfly start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test dist/test/*.test.js",
    "build": "tsc",
    "prepare": "npm run build",
    "pack:check": "npm run build && node scripts/check-pack.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.1",
    "eslint": "^10.12.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "6.7.23",
    "qrcode": "1.5.4"
  },
  "bin": {
    "wallfly": "bin/wallfly"
  },
  "files": [
    "bin/",
    "dist/src/",
    "docs/",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
